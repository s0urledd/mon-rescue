# Copy to .env at the repo root. Every script loads this automatically.
# Never commit the real file. .env is gitignored.

CHAIN_ID=10143          # 10143 = testnet, 143 = mainnet. Stay on testnet.

# ---------------------------------------------------------------------------
# Four addresses. All throwaway testnet keys.
# ---------------------------------------------------------------------------

# The victim. Also the attacker in the battle test — the same key plays both,
# because that is exactly what a compromise is.
RESEARCH_PRIVATE_KEY=0x

# Pays all gas, chooses nothing. Keep it above 10 MON: Monad caps an account's
# inflight gas at min(10 MON, lagged balance) over 3 blocks, so a thin guardian
# is throttled precisely when it needs to retry.
GUARDIAN_PRIVATE_KEY=0x
GUARDIAN_ADDRESS=0x

# Where rescued funds go, forever. Burned into the contract at construction and
# not changeable afterwards. Use a plain EOA — the sweep is a native transfer,
# so a contract without a payable receive would make it fail. This key must
# never have touched the compromised machine.
SAFE_ADDRESS=0x

# Where the simulated attacker tries to send. Battle test only.
ATTACKER_SINK=0x

# ---------------------------------------------------------------------------
# Filled in as you go
# ---------------------------------------------------------------------------

RESCUE_CONTRACT=          # printed by `deploy` (step 3)
VICTIM_ADDRESS=           # the address of RESEARCH_PRIVATE_KEY
VALIDATOR_ID=1            # validator to stake with
AUTH_WINDOW_FILE=./window.json

# ---------------------------------------------------------------------------
# Tuning — defaults are fine to start
# ---------------------------------------------------------------------------

# Biggest single latency win: run beside your own Monad node and set this, which
# removes the network round-trip that dominates detection.
MONAD_IPC_PATH=

# Ordering is a priority gas auction on total gas price, so bid to win. The
# position dwarfs any fee; being outbid is the expensive outcome.
PRIORITY_FEE_MULTIPLIER=20

# Gas is charged on the LIMIT, not usage, with no refunds. A fat limit is burned
# on every attempt AND eats the inflight budget that caps concurrency.
GAS_LIMIT=350000

RESCUE_GAS_BUDGET_MON=500
AUTH_WINDOW_SIZE=64
