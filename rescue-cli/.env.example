# Guardian hot path. ALL secrets are runtime-only and never committed.
#
# GUARDIAN_PRIVATE_KEY is the OPERATOR's key. It pays gas and broadcasts an already-authorized
# transaction. It cannot choose a destination — that is immutable in the rescue contract.
# MonRescue never accepts a protected user's private key or seed phrase.

CHAIN_ID=143
GUARDIAN_PRIVATE_KEY=

VICTIM_ADDRESS=
VALIDATOR_ID=
WITHDRAW_ID=0

# Epoch polling cadence in ms. This is the system's reaction time; there is no computable
# unlock block on Monad, so this poll IS the trigger.
EPOCH_POLL_MS=500

# Rescued value dwarfs fees, so bid to win the ordering race.
PRIORITY_FEE_MULTIPLIER=20
# Gas is charged on the LIMIT, not usage, with no refunds. Keep it tight: a fat limit is
# money burned on every attempt AND eats the inflight budget that caps concurrent attempts.
GAS_LIMIT=350000

# --- transport (biggest single latency win) ---
# Running beside your own Monad node removes the network round-trip entirely.
# Preference order: IPC -> local WebSocket -> local HTTP -> remote HTTPS.
MONAD_IPC_PATH=
MONAD_WS_URL=
MONAD_HTTP_URL=

# --- spray strategy (see STRATEGY.md) ---
# Keep a pre-signed rescue queued across the ~100-block unlock uncertainty window so a
# transaction is already at the leader when the epoch flips. Zero detection latency.
# React and fire one attempt (default when the position is already mature), or pre-queue across
# the flip window. Pre-queuing buys exactly one block -- the flip block itself -- at the cost of
# ~2 MON in premature reverts. Worth it only if the attacker reacts rather than pre-queues.
#   off    = detect and fire once  (cheap; lands at N+1)
#   window = pre-queue across the window  (lands in N; costs the burnt attempts)
SPRAY_MODE=window
SPRAY_BLOCKS_PER_ATTEMPT=3
# Bounded because Monad caps per-account inflight gas at min(10 MON, balance) over 3 blocks.
SPRAY_MAX_IN_FLIGHT=4

# --- spend policy ---
# The rescued position dwarfs any fee, so optimise for winning, not for cost. This bounds the
# aggression rather than limiting it; the spray is sized from this budget.
RESCUE_GAS_BUDGET_MON=500

# Authorization window size. Sized against what it costs an attacker to burn through, not what
# it costs us to hold. Each is one wallet signature at onboarding.
AUTH_WINDOW_SIZE=64
