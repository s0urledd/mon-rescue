# Phase 0 research harness. Secrets are supplied at runtime and NEVER committed.
#
# These keys are RESEARCH keys funded from https://faucet.monad.xyz.
# MonRescue never asks a protected user for a private key or seed phrase, and no
# package in this repository provides a code path that would accept one.

CHAIN_ID=10143

# Test "victim" EOA used by scripts A-D.
RESEARCH_PRIVATE_KEY=

# Separate guardian key (script D) — proves the trigger right is independent of the user.
GUARDIAN_PRIVATE_KEY=

# Deployed MonRescue instance and the destination hard-locked into it.
RESCUE_CONTRACT=
SAFE_ADDRESS=

# Validator to stake with / withdraw from during scripts B and C.
VALIDATOR_ID=1
WITHDRAW_ID=0
